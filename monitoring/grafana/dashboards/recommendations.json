{
  "uid": "sbi-reco",
  "title": "Smart BI · Recommendations",
  "tags": [
    "smart-bi"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests / min by business type",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (business_type) (rate(recommendation_requests_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "{{business_type}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Median score by business type",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, business_type) (rate(recommendation_score_bucket[1h])))",
          "refId": "A",
          "legendFormat": "{{business_type}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "id": 2
    },
    {
      "type": "bargauge",
      "title": "Stability (top-5 Jaccard vs previous run)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 8,
        "h": 9,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "recommendation_stability_jaccard",
          "refId": "A",
          "legendFormat": "{{business_type}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 0.6
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 3
    },
    {
      "type": "bargauge",
      "title": "Mean rank width of top 5 (p10–p90)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 8,
        "h": 9,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "recommendation_rank_width",
          "refId": "A",
          "legendFormat": "{{business_type}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "id": 4
    },
    {
      "type": "bargauge",
      "title": "Excluded for insufficient data",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 8,
        "h": 9,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (business_type) (increase(recommendation_low_coverage_total[24h]))",
          "refId": "A",
          "legendFormat": "{{business_type}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "id": 5
    },
    {
      "type": "stat",
      "title": "User feedback (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 24,
        "h": 5,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (rating) (increase(user_feedback_total[24h]))",
          "refId": "A",
          "legendFormat": "{{rating}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "id": 6
    }
  ]
}