# Copy to .env and fill in. Never commit .env.

# --- Database (used by docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sbi
# Host-side URL (python manage.py / pytest on your machine). Inside Docker the compose file builds its own.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sbi
VECTOR_DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sbi

# --- LLM (optional: without a key the agent uses the rule-based fallback, RAG uses BM25) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Map (optional: without a token a free MapLibre style is used) ---
MAPBOX_TOKEN=

# --- App ---
DATA_MODE=official
MLFLOW_TRACKING_URI=http://localhost:5000
OTEL_ENABLED=false
LOG_LEVEL=INFO

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
